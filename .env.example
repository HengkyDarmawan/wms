APP_NAME="WMS Proyek"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://wms.test

# Domain pusat (landing, login Super Admin, callback SSO F3) dan domain tenant.
# Subdomain company: <kode>.wms.test  (Blueprint A-01)
APP_CENTRAL_DOMAIN=wms.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database pusat. Koneksi tenant dibuat otomatis oleh stancl/tenancy (AD-01).
DB_CONNECTION=central
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wms_central
DB_USERNAME=root
DB_PASSWORD=
TENANT_DB_PREFIX=wms_tenant_

# Sesi melekat pada host (cookie tanpa domain induk) agar terpisah per subdomain company — BR-ACC-06
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true di produksi: tanpa penanda Secure, cookie sesi ikut terkirim lewat HTTP.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit lokal (Laragon). Produksi memakai penyedia email transaksional (O-14).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@wms.test"
MAIL_FROM_NAME="${APP_NAME}"

# Kebijakan akses (BR-ACC-06, NFR-04)
ACCESS_LOGIN_MAX_ATTEMPTS=5
ACCESS_LOCK_MINUTES=15
ACCESS_INVITATION_HOURS=72
ACCESS_PASSWORD_MIN=10
ACCESS_PASSWORD_HISTORY=3
ACCESS_SUPPORT_MAX_DAYS=7
ACCESS_LOGIN_THROTTLE=5
ACCESS_RESET_MINUTES=60
ACCESS_2FA_MAX_ATTEMPTS=5

# Akun Super Admin yang dibuat ProductionSeeder (jangan memakai nilai contoh di produksi)
PLATFORM_ADMIN_NAME="Super Admin Platform"
PLATFORM_ADMIN_EMAIL=superadmin@wms.test
PLATFORM_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
