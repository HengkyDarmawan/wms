# Templat .env SERVER (cPanel) — salin menjadi .env di /home/CPUSER/wms, lalu ganti
# semua CPUSER dan GANTI_*. Langkah lengkap: TUTORIAL-SERVER.txt langkah 3c.
# Nilai di bawah sengaja aman untuk server: debug mati (O-06), cookie hanya HTTPS,
# log tidak verbose. Setelah mengubah .env selalu: php artisan config:cache

APP_NAME="WMS Proyek"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://wms.nexateknologigroup.com
APP_CENTRAL_DOMAIN=wms.nexateknologigroup.com
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=central
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CPUSER_wms_central
DB_USERNAME=CPUSER_wms
DB_PASSWORD=GANTI_PASSWORD_DATABASE
# Database company di cPanel: CPUSER_wmst_<kode> (TUTORIAL-SERVER.txt langkah 6a).
TENANT_DB_PREFIX=CPUSER_wmst_

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Sesi terikat subdomain company (BR-ACC-06): biarkan null.
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# stancl/tenancy butuh cache bertag: array (tanpa Redis) atau redis.
CACHE_STORE=array

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email transaksional belum diputuskan (O-14). Sampai ada, email hanya ditulis ke log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@wms.nexateknologigroup.com"
MAIL_FROM_NAME="${APP_NAME}"

ACCESS_LOGIN_MAX_ATTEMPTS=5
ACCESS_LOCK_MINUTES=15
ACCESS_INVITATION_HOURS=72
ACCESS_PASSWORD_MIN=10
ACCESS_PASSWORD_HISTORY=3
ACCESS_SUPPORT_MAX_DAYS=7
ACCESS_LOGIN_THROTTLE=5
ACCESS_RESET_MINUTES=60
ACCESS_2FA_MAX_ATTEMPTS=5

PLATFORM_ADMIN_NAME="Super Admin Platform"
PLATFORM_ADMIN_EMAIL=GANTI_EMAIL_SUPERADMIN
PLATFORM_ADMIN_PASSWORD=GANTI_PASSWORD_SUPERADMIN

VITE_APP_NAME="${APP_NAME}"

WMS_MESSAGING_DRIVER=none
WMS_MESSAGING_URL=
WMS_MESSAGING_TOKEN=
WMS_MESSAGING_PHONE_FIELD=target
WMS_MESSAGING_MESSAGE_FIELD=message
WMS_WA_DRIVER=none
WMS_WA_TOKEN=
WMS_WA_PHONE_NUMBER_ID=
WMS_WA_APP_SECRET=
WMS_WA_VERIFY_TOKEN=

# Mode satu company (TUTORIAL-SERVER.txt 1c pilihan A): isi kode company, mis. demo.
WMS_SINGLE_COMPANY=
# Tombol "Coba demo" HANYA untuk server demo; server klien trial: false.
WMS_DEMO_LOGIN=false
